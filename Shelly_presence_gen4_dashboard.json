[{"id":"41f4ae2f7f40f009","type":"comment","z":"9d6045f175be2d26","name":"Shelly Presence Gen 4","info":"","x":130,"y":3100,"wires":[]},{"id":"21fe93d09d5ea886","type":"mqtt in","z":"9d6045f175be2d26","name":"","topic":"shellypresence/events/rpc","qos":"2","datatype":"auto-detect","broker":"4ab53a892fcbe5fa","nl":false,"rap":true,"rh":0,"inputs":0,"x":170,"y":3160,"wires":[["4e5839d05ef07aa3"]]},{"id":"4e5839d05ef07aa3","type":"switch","z":"9d6045f175be2d26","name":"","property":"payload.params.events[0].event","propertyType":"msg","rules":[{"t":"eq","v":"track","vt":"str"},{"t":"eq","v":"counter","vt":"str"},{"t":"eq","v":"presence","vt":"str"}],"checkall":"true","repair":false,"outputs":3,"x":390,"y":3180,"wires":[["1d05324968e020f6"],["ab57ec5443e92c5f","f8b2f6f49b52d727","76a3116ee337fefe"],["5644c33ce7763910","f8b2f6f49b52d727"]]},{"id":"1d05324968e020f6","type":"ui-template","z":"9d6045f175be2d26","group":"4933e5609976d9c9","page":"","ui":"","name":"Tracking","order":1,"width":0,"height":0,"head":"","format":"<template>\n    <div class=\"presence-container\">\n        <!-- Loop through sorted objects (up to 4) -->\n        <div v-for=\"obj in sortedObjects\" :key=\"obj.id\" class=\"person-card\">\n            <div class=\"card-header\">\n                <v-icon :style=\"{ color: getIconColor(obj.id) }\" size=\"24\">\n                    mdi-account\n                </v-icon>\n                <span class=\"id-label\">ID: {{ obj.id }}</span>\n            </div>\n\n            <div class=\"stats-grid\">\n                <div class=\"stat-item\"><strong>X:</strong> {{ obj.x.toFixed(2) }}</div>\n                <div class=\"stat-item\"><strong>Y:</strong> {{ obj.y.toFixed(2) }}</div>\n                <div class=\"stat-item\"><strong>Z:</strong> {{ obj.z.toFixed(2) }}</div>\n                <div class=\"stat-item\"><strong>Min Z:</strong> {{ obj.minz.toFixed(2) }}</div>\n                <div class=\"stat-item\"><strong>Max Z:</strong> {{ obj.maxz.toFixed(2) }}</div>\n            </div>\n        </div>\n\n        <!-- Placeholder when no one is detected -->\n        <div v-if=\"sortedObjects.length === 0\" class=\"no-data\">\n            No presence detected\n        </div>\n    </div>\n</template>\n\n<script>\n    export default {\n    data() {\n        return {\n            objects: []\n        }\n    },\n    computed: {\n        // Sorts objects by ID and limits to 4\n        sortedObjects() {\n            return [...this.objects]\n                .sort((a, b) => a.id - b.id)\n                .slice(0, 4);\n        }\n    },\n    watch: {\n        // Watches for incoming msg from Node-RED\n        msg: function (newMsg) {\n            if (newMsg.payload.params?.events?.[0]?.object) {\n                this.objects = newMsg.payload.params.events[0].object;\n            } else {\n                this.objects = [];\n            }\n        }\n    },\n    methods: {\n        getIconColor(id) {\n            const colors = ['#2196F3', '#4CAF50', '#FF9800', '#E91E63'];\n            return colors[id % colors.length];\n        }\n    }\n}\n</script>\n\n<style scoped>\n    .presence-container {\n        display: flex;\n        flex-direction: column;\n        gap: 12px;\n        padding: 8px;\n    }\n\n    .person-card {\n        background: rgba(255, 255, 255, 0.05);\n        border: 1px solid rgba(255, 255, 255, 0.1);\n        border-radius: 8px;\n        padding: 12px;\n    }\n\n    .card-header {\n        display: flex;\n        align-items: center;\n        gap: 8px;\n        margin-bottom: 8px;\n        border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n        padding-bottom: 4px;\n    }\n\n    .id-label {\n        font-weight: bold;\n        font-size: 1.1em;\n    }\n\n    .stats-grid {\n        display: grid;\n        grid-template-columns: repeat(3, 1fr);\n        gap: 8px;\n        font-family: monospace;\n        font-size: 0.9em;\n    }\n\n    .stat-item {\n        color: #212121;\n    }\n\n    .no-data {\n        text-align: center;\n        opacity: 0.5;\n        padding: 20px;\n    }\n</style>","storeOutMessages":true,"passthru":true,"resendOnRefresh":true,"templateScope":"local","className":"","x":600,"y":3160,"wires":[[]]},{"id":"ab57ec5443e92c5f","type":"ui-text","z":"9d6045f175be2d26","group":"f860635899d5454b","order":1,"width":0,"height":0,"name":"","label":"Number of Objects","format":"{{msg.payload}}","layout":"row-spread","style":false,"font":"","fontSize":16,"color":"#717171","wrapText":false,"className":"","value":"payload.params.events[0].num_objects","valueType":"msg","x":630,"y":3220,"wires":[]},{"id":"f8b2f6f49b52d727","type":"ui-text","z":"9d6045f175be2d26","group":"f860635899d5454b","order":2,"width":0,"height":0,"name":"","label":"Illumination","format":"{{msg.payload}}","layout":"row-spread","style":false,"font":"","fontSize":16,"color":"#717171","wrapText":false,"className":"","value":"payload.params.events[0].illumination","valueType":"msg","x":610,"y":3260,"wires":[]},{"id":"5644c33ce7763910","type":"ui-text","z":"9d6045f175be2d26","group":"f860635899d5454b","order":3,"width":0,"height":0,"name":"","label":"Presence","format":"{{msg.payload}}","layout":"row-spread","style":false,"font":"","fontSize":16,"color":"#717171","wrapText":false,"className":"","value":"msg.payload.params.events[0].value ? \"Presence\" : \"No person\"","valueType":"jsonata","x":600,"y":3300,"wires":[]},{"id":"76a3116ee337fefe","type":"switch","z":"9d6045f175be2d26","name":"Objects","property":"payload.params.events[0].num_objects","propertyType":"msg","rules":[{"t":"eq","v":"0","vt":"num"}],"checkall":"true","repair":false,"outputs":1,"x":220,"y":3320,"wires":[["78ce4d0e83f8b053"]]},{"id":"78ce4d0e83f8b053","type":"change","z":"9d6045f175be2d26","name":"Empty array","rules":[{"t":"set","p":"payload","pt":"msg","to":"[]","tot":"json"}],"action":"","property":"","from":"","to":"","reg":false,"x":390,"y":3320,"wires":[["1d05324968e020f6"]]},{"id":"4ab53a892fcbe5fa","type":"mqtt-broker","n